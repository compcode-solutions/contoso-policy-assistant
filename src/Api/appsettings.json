{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "contoso-policy-assistant",
    "Audience": "contoso-policy-assistant-web",
    "ExpiresHours": "8",
    "Key": "CHANGE_ME_IN_DEVELOPMENT_OR_USER_SECRETS_32CHARS_MIN"
  },
  "Policies": {
    "RootPath": "../../data/policies"
  },
  "Rag": {
    "TopK": 4,
    "MinScore": 0.12,
    "AutoIngestOnStartup": true
  },
  "Agent": {
    "MaxSteps": 4,
    "TimeoutSeconds": 30
  },
  "Ai": {
    "Provider": "Gemini",
    "DailyRequestCeiling": 10,
    "PerIpLimit": 10,
    "PerIpWindowMinutes": 15,
    "AzureOpenAI": {
      "Endpoint": "",
      "ApiKey": "",
      "ChatDeployment": "gpt-4o-mini",
      "EmbeddingDeployment": "text-embedding-3-small"
    },
    "OpenAI": {
      "ApiKey": "",
      "ChatModel": "gpt-4o-mini",
      "EmbeddingModel": "text-embedding-3-small"
    },
    "Gemini": {
      "ApiKey": "",
      "ChatModel": "gemini-2.5-flash-lite",
      "EmbeddingModel": "gemini-embedding-001"
    }
  }
}
