# Copy values into user-secrets or environment — never commit real keys.
# Prefer Azure OpenAI for the Microsoft interview story.

# Ai__Provider=AzureOpenAI
# Ai__AzureOpenAI__Endpoint=https://YOUR_RESOURCE.openai.azure.com/
# Ai__AzureOpenAI__ApiKey=
# Ai__AzureOpenAI__ChatDeployment=gpt-4o-mini
# Ai__AzureOpenAI__EmbeddingDeployment=text-embedding-3-small

# Or public OpenAI:
# Ai__Provider=OpenAI
# Ai__OpenAI__ApiKey=
# OPENAI_API_KEY=

# Default without keys: Ai__Provider=Lexical (offline bag-of-words RAG)
