# Copy values into user-secrets or environment variables — never commit real keys.
#
# Default: Ai__Provider=Gemini. Until Ai__Gemini__ApiKey is set, the factory
# falls back to Lexical (offline bag-of-words). Security and grounding
# behaviour is identical — only answer fluency differs.
#
# Production (VPS): paste the key into THIS file only:
#   /opt/apps/env/contoso.env
# chmod 600. Never put a key in this example, compose, or git.
#
# Local: from src/Api
#   dotnet user-secrets set "Ai:Gemini:ApiKey" "YOUR_KEY"
#
# Get a key: Google AI Studio → Get API key. No credit card.
#   https://aistudio.google.com/apikey

# --- Gemini (default, free tier) ----------------------------------------------
Ai__Provider=Gemini
# Ai__Gemini__ApiKey=
# Ai__Gemini__ChatModel=gemini-2.5-flash-lite
# Ai__Gemini__EmbeddingModel=gemini-embedding-001
# GEMINI_API_KEY=

# --- Abuse protection (not a spend cap — Gemini free tier has no card) --------
# Ai__DailyRequestCeiling=10
# Ai__PerIpLimit=10
# Ai__PerIpWindowMinutes=15

# --- OpenAI (optional) --------------------------------------------------------
# Ai__Provider=OpenAI
# Ai__OpenAI__ApiKey=
# Ai__OpenAI__ChatModel=gpt-4o-mini
# Ai__OpenAI__EmbeddingModel=text-embedding-3-small
# OPENAI_API_KEY=

# --- Azure OpenAI (needs a subscription + deployed models) --------------------
# Ai__Provider=AzureOpenAI
# Ai__AzureOpenAI__Endpoint=https://YOUR_RESOURCE.openai.azure.com/
# Ai__AzureOpenAI__ApiKey=
# Ai__AzureOpenAI__ChatDeployment=gpt-4o-mini
# Ai__AzureOpenAI__EmbeddingDeployment=text-embedding-3-small

# --- Auth ---------------------------------------------------------------------
# Required in any deployed environment. 32+ characters.
# Jwt__Key=
